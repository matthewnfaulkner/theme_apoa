{{!
    @template core/login_layout

    Overrides Moodle 5.3's split-screen login layout with the single centred login box
    apoa used before (Boost 4.x login.mustache).

    Context variables required for this template:
    * output - The core renderer output object (provides main_content).

    Example context (json):
    {
        "output": {
            "main_content": "<h1>Login form goes here</h1>"
        }
    }
}}
<div class="container-fluid pt-5">
    <div id="page-content" class="row">
        <div id="region-main-box" class="col-12">
            <div id="region-main" class="col-12 h-100">
                <div class="login-wrapper">
                    <div class="login-container">
                    {{{ output.main_content }}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
