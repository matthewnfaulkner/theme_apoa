{{!
    @template local_shopping_cart/shopping_cart_item

    This template will render the shopping_cart items.

    Layout: square thumbnail | name | price + actions,
    with the description spanning the full width underneath.
    The thumbnail is a fixed square frame and the image is cropped to fill it
    (object-fit: cover), so the source image dimensions don't matter.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * All data attributes are required

    Context variables required for this template:
    * userid the logged in user id
    * urls The URLs for the popover

    Example context (json):
    {
        "itemid": 3,
        "userid":3588,
        "componentname": "mod_booking",
        "area": "main",
        "price": 133,
        "expirationdate": 1642155164,
        "itemname": "Tenniscourse",
        "currency": "EUR",
        "imageurl": "https://example.com/image.png",
        "iscashier": false,
        "nodelete": false
    }

}}

<li id="item-{{componentname}}-{{area}}-{{itemid}}"
    class="sc-item"
    data-price='{{price}}'
    data-name='{{itemname}}'
    data-component='{{componentname}}'
    data-area='{{area}}'
    data-itemid='{{itemid}}'
    data-item="shopping_cart_item"
    data-currency='{{currency}}'
    data-userid='{{userid}}'>

    <div class="sc-item__grid">

        {{! Thumbnail: fixed square frame, image cropped to fill. }}
        <span class="sc-item__media item-name">
            {{#imageurl}}
                <img alt="Image of cart item: {{itemname}}" class="sc-cart-item-image"
                    src="{{.}}" loading="lazy" decoding="async">
            {{/imageurl}}
            {{^imageurl}}
                <img alt="Image of cart item: {{itemname}}" class="sc-cart-item-image sc-cart-item-image--placeholder"
                    src="{{wwwroot}}/local/shopping_cart/pix/cart.png" loading="lazy" decoding="async">
            {{/imageurl}}
        </span>

        {{! Name. }}
        <div class="sc-item__body">
            <div class="sc-item__title">
                <span class="itemname">{{{itemname}}}</span>
            </div>
        </div>

        {{! Price and actions. }}
        <div class="sc-item__aside">
            <div class="sc-item__price">
                {{> local_shopping_cart/item_price }}
            </div>

            <div class="sc-item__actions">
                {{#iscashier}}
                    <span class="item-button">
                        <i class="shoppingcart-discount-icon fa fa-fw fa-percent" aria-hidden="true"
                            data-item="shopping_cart_item" data-component="{{componentname}}" data-area="{{area}}"
                            data-itemid="{{itemid}}" data-action="discount" data-userid="{{userid}}"></i>
                    </span>
                {{/iscashier}}
                {{^nodelete}}
                    <span class="item-button">
                        <i class="fa fa-fw fa-trash-o" aria-hidden="true"
                            data-item="shopping_cart_item" data-itemid="{{itemid}}" data-component="{{componentname}}"
                            data-area="{{area}}" data-action="delete" data-userid="{{userid}}"></i>
                    </span>
                {{/nodelete}}
            </div>
        </div>

        {{! Hidden via :empty when there is no description. Keep on one line. }}
        <div class="item-description sc-item__description">{{{description}}}</div>
    </div>
</li>
