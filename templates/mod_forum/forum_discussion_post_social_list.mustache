{{!
    @template mod_forum/forum_discussion_post_social_list

    APOA: one discussion in the social forum list, as a Bootstrap 5 card.

    - The subject is a stretched-link, so the whole card opens the discussion.
    - Interactive bits (votes, tags, unread link, preview toggle, preview body) sit
      above the stretched link (position-relative z-2) so they keep working.
    - The first post's message, attachments and actions live in a collapsed preview.
    - Pinned discussions get a subtle primary border/background and a badge
      ("pinned" is added in mod_forum\local\factories\renderer, APOA change).

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Example context (json):
    {
        "id": 1,
        "discussionid": 1,
        "subject": "Journal Club 01 - Knee",
        "pinned": true,
        "discussionrepliescount": 3,
        "isreplyplural": true,
        "urls": {"discuss": "#"}
    }
}}
<article
    id="p{{id}}"
    class="apoa-social-post card position-relative {{#pinned}}apoa-social-post--pinned{{/pinned}} {{#unread}}unread{{/unread}}"
    data-post-id="{{id}}"
    data-region="post"
    data-content="forum-post"
    aria-labelledby="apoa-social-subject-{{id}}"
>
    <div class="card-body d-flex gap-3">
        {{^isdeleted}}
            {{#html.rating}}
                <div class="post-vote-column apoa-social-post__vote d-flex flex-column align-items-center align-self-center position-relative z-2">
                    {{{.}}}
                </div>
            {{/html.rating}}
        {{/isdeleted}}

        <div class="flex-grow-1 min-w-0">
            {{! Header: avatar, subject (stretched link), author/date. }}
            <div class="d-flex align-items-start gap-2">
                {{^isdeleted}}
                    {{#author}}
                        {{#urls.profileimage}}
                            <img
                                class="apoa-social-post__avatar rounded-circle flex-shrink-0"
                                src="{{{.}}}"
                                alt=""
                                aria-hidden="true"
                            >
                        {{/urls.profileimage}}
                    {{/author}}
                {{/isdeleted}}
                <div class="min-w-0">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        {{#pinned}}
                            <span class="apoa-social-post__pinbadge badge text-bg-accent">
                                {{#pix}}i/pinned, mod_forum{{/pix}}{{#str}}discussionpinned, mod_forum{{/str}}
                            </span>
                        {{/pinned}}
                        <h3 class="apoa-social-post__title fw-bold mb-0 text-break">
                            <a
                                id="apoa-social-subject-{{id}}"
                                class="stretched-link text-reset text-decoration-none"
                                href="{{urls.discuss}}"
                                data-region-content="forum-post-core-subject"
                                data-reply-subject="{{replysubject}}"
                            >{{{subject}}}</a>
                        </h3>
                    </div>
                    {{^isdeleted}}
                        <div class="small text-body-secondary mt-1">
                            {{#html.authorsubheading}}{{{.}}}{{/html.authorsubheading}}
                            {{^html.authorsubheading}}
                                {{< core/time_element }}
                                    {{$elementid}}created-{{id}}-{{uniqid}}{{/elementid}}
                                    {{$timestampval}}{{timecreated}}{{/timestampval}}
                                    {{$userdateformatval}}{{#str}} strftimedaydatetime, core_langconfig {{/str}}{{/userdateformatval}}
                                {{/core/time_element}}
                            {{/html.authorsubheading}}
                        </div>
                    {{/isdeleted}}
                </div>
            </div>

            {{^isdeleted}}
                {{! APOA: tags link to this forum's search (search.php?id=courseid&tags[]=name), not the core tag page. }}
                {{#tags.0}}
                    <div class="apoa-taglist position-relative z-2">
                        <div class="tag_list">
                            <b>{{#str}} tags, core {{/str}}:</b>
                            <ul class="inline-list">
                                {{#tags}}
                                    <li>
                                        <a href="{{config.wwwroot}}/mod/forum/search.php?id={{courseid}}&amp;tags%5B%5D={{displayname}}"
                                           class="badge bg-info text-white {{#isstandard}}standardtag{{/isstandard}}">
                                            {{#flag}}<span class="flagged-tag">{{displayname}}</span>{{/flag}}
                                            {{^flag}}{{displayname}}{{/flag}}
                                        </a>
                                    </li>
                                {{/tags}}
                            </ul>
                        </div>
                    </div>
                {{/tags.0}}
            {{/isdeleted}}

            {{! Meta row: reply/unread counts and the preview toggle. }}
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                <span class="badge rounded-pill text-bg-light border">
                    {{#isreplyplural}}{{#str}} repliesmany, forum, {{discussionrepliescount}} {{/str}}{{/isreplyplural}}{{^isreplyplural}}{{#str}} repliesone, forum, {{discussionrepliescount}} {{/str}}{{/isreplyplural}}
                </span>
                {{#discussionunreadscount}}
                    <a class="badge rounded-pill text-bg-accent text-decoration-none position-relative z-2" href="{{urls.discuss}}#unread">
                        {{#isunreadplural}}{{#str}} unreadpostsnumber, mod_forum, {{discussionunreadscount}} {{/str}}{{/isunreadplural}}{{^isunreadplural}}{{#str}} unreadpostsone, mod_forum {{/str}}{{/isunreadplural}}
                    </a>
                {{/discussionunreadscount}}
                {{^isdeleted}}
                    <button
                        type="button"
                        class="apoa-social-post__toggle btn btn-sm btn-outline-secondary ms-auto position-relative z-2 collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#apoa-social-preview-{{id}}"
                        aria-expanded="false"
                        aria-controls="apoa-social-preview-{{id}}"
                    >
                        {{#str}} preview, core {{/str}}
                        <span class="apoa-social-post__chevron" aria-hidden="true">{{#pix}} t/expanded, core {{/pix}}</span>
                    </button>
                {{/isdeleted}}
            </div>

            {{! Collapsed preview of the first post. }}
            {{^isdeleted}}
                <div id="apoa-social-preview-{{id}}" class="collapse position-relative z-2">
                    <div class="apoa-social-post__preview border-top mt-3 pt-3">
                        <div id="post-content-{{id}}" class="post-content-container no-overflow">
                            {{{message}}}
                        </div>

                        {{#haswordcount}}
                            <p class="fst-italic mb-0"><small>{{#str}} numwords, core, {{wordcount}} {{/str}}</small></p>
                        {{/haswordcount}}

                        {{#attachments}}
                            {{#isimage}}
                                <div class="attachedimages mt-2">
                                    <img
                                        class="img-fluid"
                                        src="{{{url}}}"
                                        alt="{{#str}} attachmentname, mod_forum, {{filename}} {{/str}}"
                                    >
                                    {{#urls.export}}
                                        <a href="{{{.}}}" title="{{#str}} addtoportfolio, core_portfolio {{/str}}">
                                            {{#pix}} t/portfolioadd, core {{/pix}}
                                        </a>
                                    {{/urls.export}}
                                    {{#html.plagiarism}}
                                        <div>{{{.}}}</div>
                                    {{/html.plagiarism}}
                                </div>
                            {{/isimage}}
                            {{^isimage}}
                                <div class="mt-2">
                                    <a
                                        href="{{{url}}}"
                                        aria-label="{{#str}} attachmentname, mod_forum, {{filename}} {{/str}}"
                                    >
                                        {{#pix}} {{icon}}, core {{/pix}} {{filename}}
                                    </a>
                                    {{#urls.export}}
                                        <a href="{{{.}}}" title="{{#str}} exportattachmentname, mod_forum, {{filename}} {{/str}}">
                                            {{#pix}} t/portfolioadd, core {{/pix}}
                                        </a>
                                    {{/urls.export}}
                                    {{#html.plagiarism}}
                                        <div>{{{.}}}</div>
                                    {{/html.plagiarism}}
                                </div>
                            {{/isimage}}
                        {{/attachments}}

                        {{^readonly}}
                            {{#capabilities}}
                                <div
                                    class="post-actions d-flex flex-wrap justify-content-end gap-1 mt-2"
                                    data-region="post-actions-container"
                                    role="menubar"
                                    aria-label='{{#str}} postbyuser, mod_forum, {"post": "{{subject}}", "user": "{{author.fullname}}"} {{/str}}'
                                    aria-controls="p{{id}}"
                                >
                                    {{#view}}
                                        <a data-region="post-action" href="{{{urls.view}}}" class="btn btn-sm btn-link" role="menuitem"
                                            title="{{#str}} permanentlinktopost, mod_forum {{/str}}">
                                            {{#str}} permalink, mod_forum {{/str}}
                                        </a>
                                    {{/view}}
                                    {{#edit}}
                                        <a data-region="post-action" href="{{{urls.edit}}}" class="btn btn-sm btn-link" role="menuitem">
                                            {{#str}} edit, mod_forum {{/str}}
                                        </a>
                                    {{/edit}}
                                    {{#delete}}
                                        <a data-region="post-action" href="{{{urls.delete}}}" class="btn btn-sm btn-link" role="menuitem">
                                            {{#str}} delete, mod_forum {{/str}}
                                        </a>
                                    {{/delete}}
                                    {{#export}}
                                        <a data-region="post-action" href="{{{urls.export}}}" class="btn btn-sm btn-link" role="menuitem">
                                            {{#str}} addtoportfolio, core_portfolio {{/str}}
                                        </a>
                                    {{/export}}
                                </div>
                            {{/capabilities}}
                        {{/readonly}}
                    </div>
                </div>
            {{/isdeleted}}
        </div>
    </div>
</article>
